# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# Só no servidor (Cloudflare > Worker > Settings > Variables and Secrets, como Secret). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
# Endereço público do sistema, usado nos links de convite
NEXT_PUBLIC_SITE_URL=https://app.sgengenharias.com
# WhatsApp da SG (só números, com 55)
NEXT_PUBLIC_WHATSAPP=5511915471870
# IA de ajustes
ANTHROPIC_API_KEY=
# Stripe (Pix, cartão e boleto). Sem a chave, a cobrança continua manual pelo WhatsApp.
# Stripe > Desenvolvedores > Chaves de API
STRIPE_SECRET_KEY=
# Stripe > Desenvolvedores > Webhooks > endpoint /api/stripe/webhook > "Segredo de assinatura"
STRIPE_WEBHOOK_SECRET=
